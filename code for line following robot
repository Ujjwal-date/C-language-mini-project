
#include <stdio.h>
#include <conio.h>
#include <dos.h>

void drawRobot(int x)
{
    textcolor(LIGHTCYAN);

    gotoxy(x, 9);
    cprintf(" ______ ");

    gotoxy(x, 10);
    cprintf("| ROBOT |");

    gotoxy(x, 11);
    cprintf("|______|");

    textcolor(YELLOW);

    gotoxy(x + 1, 12);
    cprintf("O    O");

    textcolor(LIGHTGREEN);

    gotoxy(x + 3, 13);
    cprintf("v");
}

void eraseRobot(int x)
{
    int i;

    textcolor(BLACK);

    for(i = 9; i <= 13; i++)
    {
        gotoxy(x, i);
        cprintf("        ");
    }
}

void main()
{
    int x, i;

    clrscr();
    textbackground(BLACK);
    clrscr();

    /* TITLE */
    textcolor(YELLOW);
    gotoxy(25, 2);
    cprintf("SMART LINE FOLLOWER ROBOT");

    /* START AND FINISH */
    textcolor(LIGHTGREEN);
    gotoxy(6, 6);
    cprintf("START");

    textcolor(LIGHTRED);
    gotoxy(67, 6);
    cprintf("FINISH");

    /* ROAD BOUNDARIES */
    textcolor(WHITE);

    for(i = 8; i <= 19; i++)
    {
        gotoxy(5, i);
        cprintf("|");

        gotoxy(75, i);
        cprintf("|");
    }

    /* ROAD CENTRE LINE */
    textcolor(DARKGRAY);

    for(i = 7; i <= 73; i += 4)
    {
        gotoxy(i, 16);
        cprintf("-");
    }

    /* ROAD LABEL */
    textcolor(LIGHTCYAN);
    gotoxy(29, 18);
    cprintf("ROBOT TRACK");

    /* INITIAL STATUS */
    textcolor(LIGHTCYAN);
    gotoxy(20, 22);
    cprintf("STATUS: SCANNING ROAD...");

    delay(1500);

    /* ROBOT MOVEMENT */
    for(x = 8; x <= 65; x++)
    {
        if(x > 8)
            eraseRobot(x - 1);

        drawRobot(x);

        textcolor(LIGHTGREEN);
        gotoxy(20, 22);
        cprintf("STATUS: FOLLOWING LINE...");

        delay(120);
    }

    /* FINAL STATUS */
    textcolor(YELLOW);
    gotoxy(20, 22);
    cprintf("STATUS: DESTINATION REACHED!");

    textcolor(LIGHTGREEN);
    gotoxy(29, 24);
    cprintf("MISSION SUCCESS!");

    textcolor(WHITE);
    gotoxy(1, 25);

    getch();
}
